[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]

[packages]
flask = ">=2.0.0"
flask-sqlalchemy = ">=3.0.0"
flask-migrate = ">=4.0.0"
flask-swagger = ">=0.2.14"
psycopg2-binary = ">=2.9"
python-dotenv = ">=0.15.0"
flask-cors = ">=4.0.0"
gunicorn = ">=20.1.0"
cloudinary = "*"
flask-admin = ">=1.5.8"
typing-extensions = "*"
flask-jwt-extended = ">=4.6.0"
wtforms = ">=3.0.0"
sqlalchemy = ">=1.4.0"
colorama = "*"
aiohttp = "*"
alembic = ">=1.7.0"
certifi = "*"
click = ">=8.0"
itsdangerous = ">=2.0"
jinja2 = ">=3.0"
mako = ">=1.2"
markupsafe = ">=2.0"
python-dateutil = "*"
python-editor = ">=1.0.4"
pyyaml = ">=6.0"
six = "*"
urllib3 = "*"
werkzeug = ">=2.0"

[requires]
python_version = "3.12.3"

[scripts]
start = "sh -c 'cd src && gunicorn \"app:app\" --bind 0.0.0.0:${PORT:-3000} --workers 3 --log-file -'"
init="flask db init"
migrate="flask db migrate"
local="heroku local"
upgrade="flask db upgrade"
downgrade="flask db downgrade"
insert-test-data="flask insert-test-data"
reset_db="bash ./docs/assets/reset_migrations.bash"
deploy="echo 'Please follow this 3 steps to deploy: https://github.com/4GeeksAcademy/flask-rest-hello/blob/master/README.md#deploy-your-website-to-heroku' "
